{
  "name": "phaser-ts-starter",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "BoringStack Phaser template: AI-first Phaser 4 + TypeScript game starter",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0",
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "depcruise": "depcruise src",
    "knip": "knip",
    "check:arch": "eslint src && depcruise src",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun run catalog:check && bun run depcruise && bun run test",
    "validate": "bun run check && bun run test:smoke",
    "catalog": "bun scripts/catalog.ts",
    "catalog:check": "bun scripts/catalog.ts --check",
    "new:module": "bun scripts/new-module.ts",
    "new:scene": "bun scripts/new-scene.ts",
    "new:feature": "bun scripts/new-feature.ts",
    "new:port": "bun scripts/new-port.ts",
    "new:content": "bun scripts/new-content.ts",
    "new:adr": "bun scripts/new-adr.ts",
    "prepare": "husky"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@5": "5.0.9",
    "esbuild": ">=0.28.1",
    "fast-uri": ">=3.1.5",
    "js-yaml": ">=4.3.1",
    "nanoid@3": "3.3.18",
    "postcss": ">=8.5.23",
    "undici": ">=7.29.0"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
