{
  "description": "Desired GitHub settings for boringstack-xyz/Phaser-TypeScript-AI-First-Starter. Applied via scripts/audit-repo-settings.sh — operator runs the printed commands.",
  "security_and_analysis": {
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled",
    "dependabot_security_updates": "enabled"
  },
  "pages": {
    "build_type": "workflow",
    "cname": "phaser.boringstack.xyz"
  },
  "actions": {
    "can_approve_pull_request_reviews": true
  },
  "merge": {
    "delete_branch_on_merge": true,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false
  },
  "template_repository": true,
  "branch_protection_main": {
    "required_status_check_contexts": [
      "typecheck + lint + test",
      "playwright smoke",
      "grep-based banned patterns",
      "dep vuln scan (osv + audit)",
      "gitleaks secret scan",
      "semgrep SAST",
      "analyze (javascript-typescript)"
    ],
    "required_approving_review_count": 1,
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": true,
    "require_last_push_approval": true,
    "enforce_admins": true,
    "required_linear_history": true,
    "required_signatures": false,
    "allow_force_pushes": false,
    "allow_deletions": false
  }
}
